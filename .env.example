# MariaDB via Prisma (não use o usuário root em produção)
DATABASE_URL="mysql://usuario:senha@127.0.0.1:3306/contrato_casamento"

# Gere um segredo aleatório com pelo menos 32 caracteres, diferente por ambiente.
AUTH_SECRET="substitua-por-um-segredo-longo-e-aleatorio"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# SMTP genérico opcional. Sem estas cinco variáveis, o site inicia normalmente,
# mas recuperação de senha e envio de convites por e-mail ficam indisponíveis.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
DEMO_USER_PASSWORD=""
# Contract preview: local development + explicit test users only; never production.
CONTRACT_PREVIEW_ENABLED=false
CONTRACT_PREVIEW_USER_IDS=
# Separate 32-byte base64 encryption key. Back up securely; do not reuse AUTH_SECRET.
CONTRACT_DATA_KEY=
# Release gate; enable only after the release checks and deployment migration.
CONTRACT_ENABLED=false
# UUIDs of nominated private reviewers. Editorial admins have no implicit access.
CONTRACT_REVIEWER_USER_IDS=
# Optional versioned keyring: JSON object of key IDs to 32-byte base64 keys.
# Keep CONTRACT_DATA_KEY for reading existing v1 records during rotation.
CONTRACT_DATA_KEYS=
CONTRACT_DATA_ACTIVE_KEY_ID=
