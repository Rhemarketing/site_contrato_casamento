# MariaDB via Prisma (não use o usuário root em produção)
DATABASE_URL="mysql://usuario:senha@127.0.0.1:3306/contrato_casamento"

# Gere um segredo aleatório com pelo menos 32 caracteres, diferente por ambiente.
AUTH_SECRET="substitua-por-um-segredo-longo-e-aleatorio"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# SMTP genérico. Em produção, configure estes valores somente no Environment do EasyPanel.
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT="587"
SMTP_USER="usuario-smtp"
SMTP_PASSWORD="substitua-pela-senha-smtp"
SMTP_FROM="Contrato de Casamento <nao-responda@exemplo.com>"
DEMO_USER_PASSWORD=""
